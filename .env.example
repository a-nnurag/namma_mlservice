# ── Service ───────────────────────────────────────────────────────────────────
ML_SERVICE_PORT=8000
LOG_LEVEL=INFO

# ── PostgreSQL ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://mluser:mlpass@postgres-ml:5432/nammakelsa_ml

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379
REDIS_BROKER_DB=0
REDIS_BUFFER_DB=1
CHUNK_BUFFER_TTL_SECONDS=86400

# ── Kafka / Redpanda ──────────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=redpanda:9092
KAFKA_CONSUMER_GROUP=ml-service-group
KAFKA_CONSUMER_BACKEND=aiokafka   # aiokafka | mock
# Upstash Kafka (production) — set USE_SSL=true and fill SASL credentials
KAFKA_USE_SSL=false
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=

# ── Storage ───────────────────────────────────────────────────────────────────
STORAGE_BACKEND=local             # local | s3
LOCAL_STORAGE_DIR=/tmp/ml-service
S3_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1

# ── Interview scorer ──────────────────────────────────────────────────────────
INTERVIEW_SCORER_BACKEND=rules    # rules | claude | gemini | openai
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=

# ── Face similarity thresholds ────────────────────────────────────────────────
FACE_SIMILARITY_THRESHOLD=0.85
VOICE_SIMILARITY_THRESHOLD=0.75

# ── Celery ────────────────────────────────────────────────────────────────────
CELERY_CONCURRENCY=2
CELERY_MAX_RETRIES=3
CELERY_RETRY_BACKOFF=60

# ── CORS ──────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
